{
  "name": "lai-chat",
  "displayName": "LAI Chat",
  "description": "Local VS Code chat participant for lai-gateway.",
  "version": "0.1.0",
  "publisher": "fenatodev",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onChatParticipant:lai.assistant",
    "onCommand:lai.openWorkbench",
    "onCommand:lai.health"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "LAI Chat",
      "properties": {
        "lai.gatewayUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "Loopback lai-gateway URL used by the LAI VS Code chat participant."
        }
      }
    },
    "commands": [
      {
        "command": "lai.openWorkbench",
        "title": "LAI: Open Workbench"
      },
      {
        "command": "lai.health",
        "title": "LAI: Check Health"
      }
    ],
    "chatParticipants": [
      {
        "id": "lai.assistant",
        "name": "lai",
        "fullName": "LAI",
        "description": "Ask the local LAI Gateway.",
        "locations": [
          "panel"
        ],
        "commands": [
          {
            "name": "health",
            "description": "Check LAI local health."
          },
          {
            "name": "workbench",
            "description": "Open the LAI Workbench."
          }
        ]
      }
    ]
  }
}
