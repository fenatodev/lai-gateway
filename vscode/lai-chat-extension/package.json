{
  "name": "lai-chat",
  "displayName": "LAI Chat",
  "description": "Participante de chat e painel lateral local para o lai-gateway.",
  "version": "0.1.1",
  "publisher": "fenatodev",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onChatParticipant:lai.assistant",
    "onCommand:lai.openWorkbench",
    "onCommand:lai.health",
    "onCommand:lai.openFolder",
    "onView:lai.projects"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "LAI Chat",
      "properties": {
        "lai.gatewayUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "Loopback lai-gateway URL used by the LAI VS Code chat participant."
        }
      }
    },
    "commands": [
      {
        "command": "lai.openWorkbench",
        "title": "LAI: Abrir Workbench"
      },
      {
        "command": "lai.health",
        "title": "LAI: Checar saúde"
      },
      {
        "command": "lai.openFolder",
        "title": "LAI: Abrir pasta/repositório"
      }
    ],
    "chatParticipants": [
      {
        "id": "lai.assistant",
        "name": "lai",
        "fullName": "LAI",
        "description": "Converse com o LAI Gateway local.",
        "commands": [
          {
            "name": "health",
            "description": "Checar saúde local do LAI."
          },
          {
            "name": "workbench",
            "description": "Abrir o LAI Workbench."
          },
          {
            "name": "pasta",
            "description": "Abrir pasta ou repositório no VS Code."
          }
        ]
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "lai.projects",
          "name": "LAI Projetos"
        }
      ]
    }
  }
}
