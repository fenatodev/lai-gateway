# Do not commit real tokens. Ever. Apparently this must be said.
LAI_GATEWAY_HARNESS_URL=http://127.0.0.1:8765
LAI_GATEWAY_TOKEN_FILE=$HOME/.config/lai/control-api-key
LAI_GATEWAY_BIND=127.0.0.1
LAI_GATEWAY_PORT=8787

# Keep disabled unless intentionally serving to a concrete private LAN IP.
LAI_GATEWAY_PRIVATE_BIND=0
LAI_GATEWAY_ACCESS_TOKEN_FILE=$HOME/.config/lai-gateway/access-token
LAI_GATEWAY_PAIR_TOKEN_FILE=$HOME/.config/lai-gateway/pair-token.json

# Optional outbound Telegram notifications. Sending stays disabled unless explicitly enabled.
LAI_GATEWAY_TELEGRAM_BOT_TOKEN_FILE=$HOME/.config/lai-gateway/telegram-bot-token
LAI_GATEWAY_TELEGRAM_CHAT_ID=
LAI_GATEWAY_TELEGRAM_ENABLE_SEND=0
